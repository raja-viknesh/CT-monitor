# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# SQLite databases (local persistence)
*.db
*.sqlite
*.sqlite3

# Models directory (dynamically populated by ml/train.py as per spec)
models/*.pkl.gz
models/*.onnx
models/*.pt
models/calibrators/*.joblib

# Downloaded Datasets (Ignore downloaded lists, keep known seed files)
data/*.csv
data/top-1m.*
data/PhishTank.*
data/DGArchive.*
# Explicitly keep seed files mentioned in spec
!data/brands_10k.txt
!data/tld_rules.yaml

# Reports
*.sarif
ctmonitor-report.sarif

# Frontend build artifacts (if using any bundler in future)
dashboard/dist/
dashboard/node_modules/
dashboard/.cache/

# IDEs and OS specific
.vscode/
.idea/
.DS_Store
Thumbs.db
