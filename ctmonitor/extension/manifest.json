{
  "manifest_version": 3,
  "name": "CTMonitor Threat Protection",
  "version": "0.1.0",
  "description": "Real-time phishing and typosquatting protection powered by local CTMonitor engine.",
  "permissions": ["tabs", "storage", "webNavigation", "alarms"],
  "host_permissions": ["http://127.0.0.1:8000/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}