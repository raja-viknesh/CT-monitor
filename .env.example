# CTMonitor Environment Configuration Example
# Copy this to .env and customize for your environment

# === Certstream Configuration ===
CERTSTREAM_URL=wss://certstream.calidog.io

# === FastAPI Server ===
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_WORKERS=4

# === Dashboard ===
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# === Database ===
DB_PATH=./ctmonitor.db

# === Models ===
MODELS_DIR=./models
FORCE_RETRAIN_MODELS=false

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=./ctmonitor.log

# === Ring Buffer Configuration ===
RING_BUFFER_SIZE=10000

# === Detection Thresholds ===
THRESHOLD_BLOCK=0.85
THRESHOLD_WARN=0.60
THRESHOLD_WATCH=0.35

# === WHOIS Cache ===
WHOIS_CACHE_TTL_DAYS=7

# === Keyboard Interrupt Grace Period ===
SHUTDOWN_TIMEOUT_SECONDS=10
